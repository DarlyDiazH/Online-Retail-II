# Copia este archivo como .env y pon tus valores reales (el .env NO se sube a GitHub).

# Cadena de conexión de Neon (Dashboard de Neon -> Connection string).
# Debe empezar por postgresql:// y terminar en ?sslmode=require
DATABASE_URL=postgresql://usuario:clave@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
# Si DATABASE_URL está vacío se usa SQLite local (carrito_dev.db) para desarrollo.

# Origen del frontend (Vite) permitido por CORS
FRONTEND_ORIGIN=http://localhost:5173

# Ruta al archivo de productos que genera el módulo de catálogo (Persona 2).
# Si no existe, el carrito usa los productos de ejemplo del propio módulo.
PRODUCTOS_PATH=data/productos.json

# Consulta SQL para obtener el segmento de un usuario (módulo de Persona 1).
# Debe devolver una sola columna con el nombre del segmento y recibir :usuario_id.
# Si falla o no devuelve nada, el usuario se trata como "Nuevo".
SEGMENTO_SQL=SELECT v.segmento FROM usuarios u JOIN vw_descuentos_checkout v ON v.customer_id = u.customer_id WHERE u.id = :usuario_id

# Consulta para comprobar que un Customer_ID existe en la tabla de clientes segmentados
# (módulo de autenticación). Debe recibir :customer_id. Usa la vista real de Neon.
CLIENTE_SQL=SELECT 1 FROM vw_descuentos_checkout WHERE customer_id = :customer_id
